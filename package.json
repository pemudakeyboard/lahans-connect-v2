{
  "name": "lahans-connect",
  "version": "0.1.0",
  "private": true,
  "description": "LAHANS Connect — HRIS PT Lahan Mekar Niaga (LMN Group). Monorepo: NestJS API + Next.js web + Flutter mobile (deferred).",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "db:migrate": "pnpm --filter @lahans/api db:migrate",
    "db:seed": "pnpm --filter @lahans/api db:seed",
    "db:studio": "pnpm --filter @lahans/api db:studio",
    "gates": "bash scripts/gates.sh",
    "gates:check": "pnpm -r gates"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^6.19.3",
    "@prisma/client": "^6.19.3"
  }
}
