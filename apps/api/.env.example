# ============================================================
# LAHANS CONNECT API — environment template
# Infra credentials ONLY. Business rules live in system_parameters
# and config tables (zero hardcode). See BRD §13 rule 1.
# ============================================================

# --- Database (PostgreSQL 16) ---
DATABASE_URL="postgresql://lahans_app:LAHANS_DB_PASSWORD@localhost:5432/lahans_dev?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_TTL=900            # 15 minutes (BRD 7.4)
JWT_REFRESH_TTL=604800        # 7 days (BRD 7.4)

# --- App ---
PORT=3000
NODE_ENV=development

# --- Object storage (BR-FILE-03) ---
STORAGE_DRIVER=local-disk      # local-disk | s3
STORAGE_LOCAL_PATH=./storage-local

# --- Observability ---
LOG_LEVEL=info